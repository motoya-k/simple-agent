# Anthropic API (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock (SIMPLE_AGENT_PROVIDER=bedrock)
# AWS_BEARER_TOKEN_BEDROCK=...     # Bedrock API key, minted in the region below
# AWS_REGION=ap-northeast-1

# Google Gemini (SIMPLE_AGENT_PROVIDER=gemini)
# GEMINI_API_KEY=...

# OpenAI Responses / Codex models (SIMPLE_AGENT_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_RESPONSES_URL=...         # only for Azure OpenAI or a proxy

# TypeSafe Jev — skips background review passes a turn has nothing for
# TYPESAFE_API_KEY=...

# Long-term memory — the team's shared knowledge (SIMPLE_AGENT_MEMORY_BACKEND)
# local (default): ~/.simple-agent/memories/<namespace>.jsonl, no service needed
# MEM0_API_KEY=...                 # memory_backend=mem0; namespace = mem0 app_id
# HINDSIGHT_API_URL=http://localhost:8888   # memory_backend=hindsight; namespace = bank
# HINDSIGHT_API_KEY=

# Optional overrides (same keys work in ~/.simple-agent/config.yaml; env wins)
# SIMPLE_AGENT_PROVIDER=anthropic  # anthropic | bedrock | gemini | openai
# SIMPLE_AGENT_MODEL=              # empty = the provider's default
# SIMPLE_AGENT_REVIEW_MODEL=
# SIMPLE_AGENT_LEARNING=1          # 0 disables the background review
# SIMPLE_AGENT_MEMORY_BACKEND=local  # local | mem0 | hindsight
# SIMPLE_AGENT_MEMORY_NAMESPACE=default  # the team or org this memory belongs to
# SIMPLE_AGENT_HOME=~/.simple-agent
# SIMPLE_AGENT_DATABASE_URL=     # postgresql://... moves transcripts off SQLite (pip install ".[postgres]")
