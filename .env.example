# Anthropic API (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock (SIMPLE_AGENT_PROVIDER=bedrock) — either a Bedrock API key...
# AWS_BEARER_TOKEN_BEDROCK=...     # minted in the region below
# ...or IAM credentials, signed with SigV4 (static keys; not SSO/assume-role)
# AWS_PROFILE=my-profile           # from ~/.aws/credentials
# AWS_ACCESS_KEY_ID=... / AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-northeast-1        # else the profile's region, else Tokyo

# Google Gemini (SIMPLE_AGENT_PROVIDER=gemini)
# GEMINI_API_KEY=...

# OpenAI Responses / Codex models (SIMPLE_AGENT_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_RESPONSES_URL=...         # only for Azure OpenAI or a proxy

# TypeSafe Jev — skips background review passes a turn has nothing for
# TYPESAFE_API_KEY=...

# Optional overrides (same keys work in ~/.simple-agent/config.yaml; env wins)
# SIMPLE_AGENT_PROVIDER=anthropic  # anthropic | bedrock | gemini | openai
# SIMPLE_AGENT_MODEL=              # empty = the provider's default
# SIMPLE_AGENT_REVIEW_MODEL=
# SIMPLE_AGENT_LEARNING=1          # 0 disables the background review everywhere
# SIMPLE_AGENT_HOME=~/.simple-agent
# SIMPLE_AGENT_PROFILE=terminal    # who the agent is by default; see profiles below

# Where everything this agent writes is kept — transcripts, long-term memory,
# and skills, all three together. One setting, no half-moved deployments.
# Empty: files under SIMPLE_AGENT_HOME (SQLite + JSONL + directories).
# SIMPLE_AGENT_DATABASE_URL=       # postgresql://...  (pip install ".[postgres]")
# SIMPLE_AGENT_MEMORY_NAMESPACE=default  # the team this memory and these conversations belong to

# A hosted memory service (mem0, Hindsight, your own vector store) is not a
# backend here — it is an MCP server in ~/.simple-agent/mcp.json, declared once
# and reaching every harness. See "Connect MCP servers" in the README.

# Profiles — who the agent is on a route: instructions, tools, learning,
# namespace. Built in: terminal, email. Amend or add one with a file at
# ~/.simple-agent/profiles/<name>.md; these variables override it.
# SIMPLE_AGENT_EMAIL_TOOLS=skill_view   # read-only by default; see profile.py
# SIMPLE_AGENT_EMAIL_LEARNING=0         # mail may not teach long-term memory
# SIMPLE_AGENT_EMAIL_NAMESPACE=

# The email profile's own settings (simple-agent --email)
# SIMPLE_AGENT_IMAP_HOST=imap.gmail.com
# SIMPLE_AGENT_IMAP_USER=agent@example.com
# SIMPLE_AGENT_IMAP_PASSWORD=...   # env only, never from a profile file
# SIMPLE_AGENT_EMAIL_ALLOW=alice@example.com,@example.com
