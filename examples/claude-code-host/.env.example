# Copy to the repo root as `.env` and run host.py from there: load_dotenv()
# reads ./.env and uses setdefault, so a real environment variable always wins.
#   cp examples/claude-code-host/.env.example .env

# -- the engine ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_USE_BEDROCK=1        # ...or Bedrock, with an AWS role/profile
# CLAUDE_MODEL=sonnet              # empty = whatever Claude Code defaults to
# CLAUDE_MAX_BUDGET_USD=0.50       # a ceiling per turn, for an unattended host
# CLAUDE_BINARY=claude

# -- where the conversations are kept -----------------------------------
SIMPLE_AGENT_DATABASE_URL=postgresql://user:pass@host:5432/agent
SIMPLE_AGENT_HOME=/home/agent/.simple-agent

# -- Slack (the I/O: Socket Mode, no public URL) ------------------------
SIMPLE_AGENT_SLACK_APP_TOKEN=xapp-...     # app-level token, connections:write
SIMPLE_AGENT_SLACK_BOT_TOKEN=xoxb-...     # bot token; the Sink posts with it
# The Slack *MCP server* in mcp.json is a separate thing — for acting in Slack
# beyond answering. It wants its own token:
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T01234567
# Overrides the profile files, for a container that ships without them:
# SIMPLE_AGENT_SLACK_ALLOW=#ops, dm
# SIMPLE_AGENT_SLACK_OPS_CHANNEL=C0123456789

# -- the mailbox --------------------------------------------------------
SIMPLE_AGENT_IMAP_PASSWORD=...
# SIMPLE_AGENT_IMAP_HOST=imap.gmail.com     # else from profiles/email.md
# SIMPLE_AGENT_IMAP_USER=agent@example.com
# SIMPLE_AGENT_EMAIL_ALLOW=@example.com

# -- the MCP servers in mcp.json ----------------------------------------
# Every ${VAR} the template still contains must be set, or the host refuses to
# start. Delete a server from mcp.json and its variables go with it.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=...
NOTION_TOKEN=ntn_...
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
USER_GOOGLE_EMAIL=you@example.com
