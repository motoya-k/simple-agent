# Copy to the repo root as `.env`: load_dotenv() reads ./.env with setdefault,
# so a real environment variable always wins.
#   cp examples/pr-watch/.env.example .env

# -- the model ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# SIMPLE_AGENT_PROVIDER=bedrock    # ...or Bedrock with a role; see the repo root's .env.example

# -- GitHub -------------------------------------------------------------
# mcp.json passes this to the server's container by name, so the token lives
# here and nowhere else. Read access to the repositories is enough.
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# -- where the report goes ----------------------------------------------
# The job's `to: slack:C...` needs the bot token to deliver; without it the
# answer goes to the dead-letter file instead.
SIMPLE_AGENT_SLACK_BOT_TOKEN=xoxb-...

# -- what it remembers --------------------------------------------------
# Required in a container: the transcript ("what I already reported") and the
# cron cursor ("which firings have run") both live here.
# SIMPLE_AGENT_DATABASE_URL=postgresql://user:pass@host:5432/agent
